<%- include('../partials/admheader') %>
<link href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@400;500;600;700&display=swap" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/@mdi/font@6.5.95/css/materialdesignicons.min.css" rel="stylesheet">

<style>
    :root {
        --primary: #0d9488;
        --primary-light: #2dd4bf;
        --secondary: #1e293b;
        --accent: #f59e0b;
        --bg: #f8fafc;
        --card-bg: #ffffff;
        --text-main: #0f172a;
        --text-muted: #64748b;
        --sidebar-width: 260px;
    }

    body {
        font-family: 'Inter', sans-serif;
        background-color: var(--bg);
        color: var(--text-main);
        overflow-x: hidden;
    }

    /* Modern Scrollbar */
    ::-webkit-scrollbar { width: 6px; }
    ::-webkit-scrollbar-track { background: #f1f1f1; }
    ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 10px; }
    ::-webkit-scrollbar-thumb:hover { background: #94a3b8; }

    /* Layout Structure */
    .admin-wrapper {
        display: flex;
        min-height: 100vh;
    }

    .main-content {
        flex: 1;
        padding: 2rem;
        margin-left: var(--sidebar-width);
        transition: margin 0.3s ease;
    }

    /* Sidebar Styling */
    .sidebar {
        width: var(--sidebar-width);
        background: var(--secondary);
        position: fixed;
        height: 100vh;
        z-index: 1000;
        color: white;
        padding-top: 20px;
    }

    .sidebar .nav-link {
        color: #94a3b8;
        padding: 12px 25px;
        display: flex;
        align-items: center;
        font-weight: 500;
        transition: all 0.2s;
        border-radius: 0 50px 50px 0;
        margin: 4px 0;
        margin-right: 15px;
    }

    .sidebar .nav-link:hover {
        color: white;
        background: rgba(255,255,255,0.05);
        padding-left: 30px;
    }

    .sidebar .nav-link.active {
        color: white;
        background: var(--primary);
        box-shadow: 0 4px 15px rgba(13, 148, 136, 0.3);
    }

    .sidebar .menu-icon {
        margin-right: 12px;
        font-size: 1.2rem;
    }

    /* Brand Logo */
    .brand-logo-container {
        padding: 0 25px 30px;
        border-bottom: 1px solid rgba(255,255,255,0.05);
        margin-bottom: 20px;
    }

    /* Stat Cards */
    .stat-card {
        background: var(--card-bg);
        border: none;
        border-radius: 16px;
        padding: 1.5rem;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03);
        transition: transform 0.2s, box-shadow 0.2s;
        height: 100%;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }

    .stat-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
    }

    .stat-icon {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        margin-bottom: 1rem;
    }

    .stat-value {
        font-size: 1.75rem;
        font-weight: 700;
        font-family: 'Outfit', sans-serif;
        color: var(--text-main);
        margin-bottom: 0.25rem;
    }

    .stat-label {
        color: var(--text-muted);
        font-size: 0.875rem;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.025em;
    }

    /* Charts Section */
    .chart-card {
        background: var(--card-bg);
        border-radius: 20px;
        border: none;
        box-shadow: 0 10px 25px -5px rgba(0,0,0,0.05);
        margin-bottom: 2rem;
    }

    .card-header-custom {
        padding: 1.5rem 1.5rem 0.5rem;
        background: transparent;
        border: none;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .chart-container {
        padding: 1.5rem;
        position: relative;
    }

    /* Best Selling List */
    .list-item-custom {
        padding: 1rem;
        border-bottom: 1px solid #f1f5f9;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .list-item-custom:last-child { border-bottom: none; }

    .badge-soft {
        padding: 6px 12px;
        border-radius: 8px;
        font-weight: 600;
        font-size: 0.75rem;
    }

    .badge-primary-soft { background: #e0f2fe; color: #0369a1; }

    /* Controls */
    .timeframe-select {
        background: white;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        padding: 8px 12px;
        font-weight: 500;
        color: var(--text-main);
        cursor: pointer;
        outline: none;
    }

    .timeframe-select:focus { border-color: var(--primary); }

    @media (max-width: 992px) {
        .main-content { margin-left: 0; padding: 1rem; }
        .sidebar { transform: translateX(-100%); transition: transform 0.3s; }
        .sidebar.active { transform: translateX(0); }
    }
</style>
  
<div class="admin-wrapper">
    <!-- Sidebar -->
    <nav class="sidebar" id="sidebar">
        <div class="brand-logo-container">
            <span style="font-size: 24px; font-weight: 700; color: white; display: flex; align-items: center; font-family: 'Outfit', sans-serif;">
                <i class="mdi mdi-glasses mr-2" style="color: var(--primary-light);"></i>
                <span>EYEGAZE</span>
            </span>
        </div>
        <ul class="nav flex-column">
            <li class="nav-item"><a class="nav-link active" href="/admin/dashboard"><i class="mdi mdi-view-dashboard menu-icon"></i>Dashboard</a></li>
            <li class="nav-item"><a class="nav-link" href="/admin/products"><i class="mdi mdi-package-variant-closed menu-icon"></i>Products</a></li>
            <li class="nav-item"><a class="nav-link" href="/admin/category"><i class="mdi mdi-shape menu-icon"></i>Categories</a></li>
            <li class="nav-item"><a class="nav-link" href="/admin/brand"><i class="mdi mdi-tag menu-icon"></i>Brands</a></li>
            <li class="nav-item"><a class="nav-link" href="/admin/orders"><i class="mdi mdi-cart menu-icon"></i>Orders</a></li>
            <li class="nav-item"><a class="nav-link" href="/admin/sales"><i class="mdi mdi-chart-line menu-icon"></i>Sales Report</a></li>
            <li class="nav-item"><a class="nav-link" href="/admin/offers"><i class="mdi mdi-gift menu-icon"></i>Offers</a></li>
            <li class="nav-item"><a class="nav-link" href="/admin/users"><i class="mdi mdi-account-multiple menu-icon"></i>Users</a></li>
            <li class="nav-item"><a class="nav-link" href="/admin/coupon"><i class="mdi mdi-ticket-percent menu-icon"></i>Coupons</a></li>
            <li class="nav-item" style="margin-top: auto;"><a class="nav-link text-danger" href="/admin/logout"><i class="mdi mdi-logout menu-icon"></i>Logout</a></li>
        </ul>
    </nav>

    <!-- Main Content -->
    <main class="main-content">
        <!-- Top Header -->
        <header class="d-flex justify-content-between align-items-center mb-5">
            <div>
                <h2 style="font-weight: 700; color: var(--secondary); margin-bottom: 5px;">Dashboard Overview</h2>
                <p class="text-muted">Welcome back, Akhil! Here's what's happening today.</p>
            </div>
            <div class="d-flex align-items-center bg-white p-2 rounded-pill shadow-sm" style="border: 1px solid #e2e8f0;">
                <label for="timeFrame" class="mb-0 mx-3 font-weight-bold text-muted">Range:</label>
                <select id="timeFrame" class="timeframe-select border-0">
                    <option value="Yearly">Yearly</option>
                    <option value="Monthly">Monthly</option>
                    <option value="Weekly">Weekly</option>
                </select>
            </div>
        </header>

        <!-- Stats Row -->
        <div class="row mb-5">
            <div class="col-xl-3 col-md-6 mb-4">
                <div class="stat-card">
                    <div>
                        <div class="stat-icon" style="background: #ecfdf5; color: #059669;"><i class="mdi mdi-currency-inr"></i></div>
                        <div class="stat-label">Total Revenue</div>
                        <div class="stat-value" id="totalRevenueVal">₹<%= totalSales.toLocaleString('en-IN') %></div>
                    </div>
                    <div class="mt-2 text-success" style="font-size: 0.8rem; font-weight: 600;">
                        <i class="mdi mdi-trending-up mr-1"></i> +12.5% from last period
                    </div>
                </div>
            </div>
            <div class="col-xl-3 col-md-6 mb-4">
                <div class="stat-card">
                    <div>
                        <div class="stat-icon" style="background: #eff6ff; color: #2563eb;"><i class="mdi mdi-shopping-outline"></i></div>
                        <div class="stat-label">Total Orders</div>
                        <div class="stat-value"><%= count %></div>
                    </div>
                    <div class="mt-2 text-muted" style="font-size: 0.8rem;">
                        Orders in selected period
                    </div>
                </div>
            </div>
            <div class="col-xl-3 col-md-6 mb-4">
                <div class="stat-card">
                    <div>
                        <div class="stat-icon" style="background: #fef2f2; color: #dc2626;"><i class="mdi mdi-account-group-outline"></i></div>
                        <div class="stat-label">Active Users</div>
                        <div class="stat-value"><%= locals.totalUsers || 0 %></div>
                    </div>
                    <div class="mt-2 text-muted" style="font-size: 0.8rem;">
                        Registered customers
                    </div>
                </div>
            </div>
            <div class="col-xl-3 col-md-6 mb-4">
                <div class="stat-card">
                    <div>
                        <div class="stat-icon" style="background: #fffbeb; color: #d97706;"><i class="mdi mdi-wallet-outline"></i></div>
                        <div class="stat-label">Avg. Order Value</div>
                        <div class="stat-value">₹<%= locals.averageOrderValue ? Math.round(averageOrderValue).toLocaleString('en-IN') : 0 %></div>
                    </div>
                    <div class="mt-2 text-warning" style="font-size: 0.8rem; font-weight: 600;">
                        Efficiency metric
                    </div>
                </div>
            </div>
        </div>

        <!-- Charts Grid -->
        <div class="row">
            <div class="col-lg-8 mb-4">
                <div class="chart-card">
                    <div class="card-header-custom">
                        <h5 style="font-weight: 700; color: var(--secondary); margin: 0;">Sales Performance</h5>
                        <i class="mdi mdi-dots-horizontal text-muted cursor-pointer"></i>
                    </div>
                    <div class="chart-container" style="height: 350px;">
                        <canvas id="salesOverTimeChart"></canvas>
                    </div>
                </div>
            </div>
            <div class="col-lg-4 mb-4">
                <div class="chart-card">
                    <div class="card-header-custom">
                        <h5 style="font-weight: 700; color: var(--secondary); margin: 0;">Order Status</h5>
                    </div>
                    <div class="chart-container" style="height: 350px; display: flex; flex-direction: column; justify-content: center;">
                        <canvas id="orderStatusChart"></canvas>
                        <div class="mt-4 d-flex justify-content-center gap-3">
                            <div class="d-flex align-items-center mr-3">
                                <span style="width: 10px; height: 10px; background: #0d9488; border-radius: 50%; display: inline-block; margin-right: 5px;"></span>
                                <span class="small font-weight-bold">Delivered</span>
                            </div>
                            <div class="d-flex align-items-center mr-3">
                                <span style="width: 10px; height: 10px; background: #f43f5e; border-radius: 50%; display: inline-block; margin-right: 5px;"></span>
                                <span class="small font-weight-bold">Cancelled</span>
                            </div>
                            <div class="d-flex align-items-center">
                                <span style="width: 10px; height: 10px; background: #fbbf24; border-radius: 50%; display: inline-block; margin-right: 5px;"></span>
                                <span class="small font-weight-bold">Returned</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Best Selling Section -->
        <div class="row mt-4">
            <div class="col-md-4 mb-4">
                <div class="chart-card p-4">
                    <h6 class="mb-4" style="font-weight: 700; color: var(--secondary); display: flex; align-items: center;">
                        <i class="mdi mdi-shape-outline mr-2 text-primary"></i> Top Categories
                    </h6>
                    <div class="best-selling-list">
                        <% bestCategories.forEach(category => { %>
                            <div class="list-item-custom">
                                <div>
                                    <div class="font-weight-bold" style="font-size: 0.9rem;"><%= category.categoryName %></div>
                                    <div class="progress mt-1" style="height: 4px; width: 100px;">
                                        <div class="progress-bar bg-primary" role="progressbar" style="width: <%= (category.totalSold / 50) * 100 %>%"></div>
                                    </div>
                                </div>
                                <span class="badge-soft badge-primary-soft"><%= category.totalSold %> Sold</span>
                            </div>
                        <% }); %>
                    </div>
                </div>
            </div>

            <div class="col-md-4 mb-4">
                <div class="chart-card p-4">
                    <h6 class="mb-4" style="font-weight: 700; color: var(--secondary); display: flex; align-items: center;">
                        <i class="mdi mdi-tag-outline mr-2 text-warning"></i> Best Brands
                    </h6>
                    <div class="best-selling-list">
                        <% bestBrands.forEach(brand => { %>
                            <div class="list-item-custom">
                                <div class="font-weight-bold" style="font-size: 0.9rem;"><%= brand.brandName %></div>
                                <span class="badge-soft" style="background: #fff7ed; color: #9a3412;"><%= brand.totalSold %> Sold</span>
                            </div>
                        <% }); %>
                    </div>
                </div>
            </div>

            <div class="col-md-4 mb-4">
                <div class="chart-card p-4">
                    <h6 class="mb-4" style="font-weight: 700; color: var(--secondary); display: flex; align-items: center;">
                        <i class="mdi mdi-trophy-outline mr-2 text-accent"></i> Top Products
                    </h6>
                    <div class="best-selling-list">
                        <% topProducts.forEach(product => { %>
                            <div class="list-item-custom">
                                <div style="max-width: 150px;">
                                    <div class="font-weight-bold text-truncate" style="font-size: 0.9rem;"><%= product.productName %></div>
                                    <div class="small text-muted">₹<%= product.price.toLocaleString('en-IN') %></div>
                                </div>
                                <span class="badge-soft" style="background: #f0fdf4; color: #166534;"><%= product.totalSold %> Sold</span>
                            </div>
                        <% }) %>
                    </div>
                </div>
            </div>
        </div>
    </main>
</div>
        


<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
  document.addEventListener('DOMContentLoaded', function() {
    // 1. Sales Over Time Chart (Modern Bar/Area)
    const salesCtx = document.getElementById('salesOverTimeChart').getContext('2d');
    const salesData = JSON.parse('<%- salesData %>');
    const timeframe = '<%- timeframe %>';

    const gradient = salesCtx.createLinearGradient(0, 0, 0, 400);
    gradient.addColorStop(0, 'rgba(13, 148, 136, 0.6)');
    gradient.addColorStop(1, 'rgba(13, 148, 136, 0.05)');

    const labels = salesData.map(item => item._id);
    const values = salesData.map(item => item.totalSales);

    new Chart(salesCtx, {
        type: 'line', // Changed to line for a smoother look
        data: {
            labels: labels,
            datasets: [{
                label: 'Revenue',
                data: values,
                backgroundColor: gradient,
                borderColor: '#0d9488',
                borderWidth: 3,
                fill: true,
                tension: 0.4, // Smooth curves
                pointBackgroundColor: '#fff',
                pointBorderColor: '#0d9488',
                pointBorderWidth: 2,
                pointRadius: 4,
                pointHoverRadius: 6
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: { display: false },
                tooltip: {
                    backgroundColor: '#1e293b',
                    padding: 12,
                    titleFont: { size: 14, weight: 'bold' },
                    bodyFont: { size: 13 },
                    callbacks: {
                        label: (context) => ` ₹${context.parsed.y.toLocaleString('en-IN')}`
                    }
                }
            },
            scales: {
                y: {
                    beginAtZero: true,
                    grid: { color: '#f1f5f9' },
                    ticks: {
                        callback: (value) => '₹' + value.toLocaleString('en-IN'),
                        font: { size: 11 }
                    }
                },
                x: {
                    grid: { display: false },
                    ticks: { font: { size: 11 } }
                }
            }
        }
    });

    // 2. Order Status Chart (Modern Donut)
    const statusCtx = document.getElementById('orderStatusChart').getContext('2d');
    new Chart(statusCtx, {
        type: 'doughnut',
        data: {
            labels: ['Delivered', 'Cancelled', 'Returned'],
            datasets: [{
                data: [
                    '<%= statusData.delivered %>', 
                    '<%= statusData.cancelled %>', 
                    '<%= statusData.returned %>'
                ],
                backgroundColor: ['#0d9488', '#f43f5e', '#fbbf24'],
                hoverOffset: 10,
                borderWidth: 0,
                cutout: '75%' // Makes it a thin, modern donut
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: { display: false }
            }
        }
    });

    // 3. Timeframe Logic
    document.getElementById('timeFrame').addEventListener('change', function() {
        const selectedValue = this.value;
        const currentUrl = new URL(window.location.href);
        currentUrl.searchParams.set('timeframe', selectedValue);
        window.location.href = currentUrl.toString();
    });

    // Set initial select value
    const urlParams = new URLSearchParams(window.location.search);
    const timeframeParam = urlParams.get('timeframe');
    if (timeframeParam) {
        document.getElementById('timeFrame').value = timeframeParam;
    }
});
</script>

<script src="https://code.jquery.com/jquery-3.3.1.slim.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.14.7/umd/popper.min.js"></script>
<script src="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/js/bootstrap.min.js"></script>

<%- include('../partials/footer') %>


